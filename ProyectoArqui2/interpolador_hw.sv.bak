// interpolador_hw.sv
module interpolador_hw (
  input  logic [7:0] p00, p10, p01, p11,
  input  logic [15:0] fx_q, fy_q,
  output logic [7:0] out
);
  import interp_pkg::*;

  // Aplicamos interpolación bilineal
  assign out = bilinear4_u8_q8_8(p00, p10, p01, p11, q8_8_t'(fx_q), q8_8_t'(fy_q));
endmodule
